# Производные сборки и локальные зависимости.
/target/
/vendor/
/.tmp/
/dist/
/lastver/
/snapshots/
*.log
# Доказательство приёмки хранит лог, на который ссылается его SHA256SUMS.
!/evidence/**/*.log
/selftest.json

# Сохраняемые данные, очистка к ним не применяется.
/.node/
/.secrets/
/fixtures/
/archive/
/.cleanup-rollback/
/_acl-recovery/
.wallet-data/
.env
/docs/testnet-funded.txt
/docs/grinflint-ci-wallet.txt

# Самостоятельные проекты и локальные инструменты.
/mobile/
/projects/
/tools/gh.exe

# Восстанавливаемые runtime assets; manifest/VC runtime отслеживаются.
/resources/node/
/resources/wallet/
/resources/tor/
/resources/src/
