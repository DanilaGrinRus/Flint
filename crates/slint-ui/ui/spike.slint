import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NavButton } from "nav-button.slint";

export struct ActivityRow {
    title: string,
    amount: string,
    when: string,
}

export struct SwapRow {
    id: string,
    pair: string,
    rate: string,
    bounds: string,
    stamps: string,
}

export struct MessageRow {
    direction: string,
    text: string,
    when: string,
    incoming: bool,
    slatepack: bool,
}

export struct ContactRow {
    address: string,
    short-address: string,
    name: string,
}

export struct PendingRow {
    id: string,
    amount: string,
    state: string,
    next-action: string,
    error: string,
    can-retry: bool,
    can-cancel: bool,
    can-export: bool,
    can-export-request: bool,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    in property <length> button-height: 42px;
    in property <length> min-button-width: 96px;
    callback clicked();

    height: root.button-height;
    min-width: root.min-button-width;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    border-radius: Theme.radius-control;
    background: !root.enabled ? Theme.surface-2
        : root.kind == "primary" ? (touch.has-hover ? Theme.accent-dim : Theme.accent)
        : root.kind == "secondary" ? (touch.has-hover ? Theme.surface-hover : Theme.surface-2)
        : root.kind == "danger" ? (touch.has-hover ? Theme.danger-soft : transparent)
        : (touch.has-hover ? Theme.surface-2 : transparent);
    border-width: root.kind == "primary" ? 0px : 1px;
    border-color: root.kind == "ghost" ? transparent
        : root.kind == "danger" ? Theme.danger
        : (touch.has-hover ? Theme.border-strong : Theme.border);
    opacity: root.enabled ? 1.0 : 0.35;

    HorizontalLayout {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        spacing: 9px;
        alignment: center;
        if root.icon.width > 0 : Rectangle {
            width: 16px;
            Image {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                colorize: root.kind == "primary" ? Theme.bg
                    : root.kind == "secondary" ? Theme.accent
                    : root.kind == "danger" ? Theme.danger : Theme.muted-2;
                image-fit: contain;
            }
        }
        Text {
            text: root.label;
            color: root.kind == "primary" ? Theme.bg
                : root.kind == "secondary" ? Theme.text
                : root.kind == "danger" ? Theme.danger
                : (touch.has-hover ? Theme.text : Theme.muted-2);
            font-size: 13px;
            font-weight: root.kind == "primary" ? 600 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ProfileChip inherits Rectangle {
    in property <string> profile;
    in property <bool> selected: false;
    callback clicked();

    height: 30px;
    min-width: 48px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: root.selected ? Theme.accent-soft : Theme.surface-2;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-line : Theme.border;
    Text {
        text: root.profile;
        color: root.selected ? Theme.text : Theme.muted-2;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ProfileTile inherits Rectangle {
    in property <string> profile;
    in property <bool> selected: false;
    in property <length> tile-width: 68px;
    callback clicked();

    width: root.tile-width;
    height: 82px;
    border-radius: 16px;
    background: root.selected ? Theme.accent-soft : Theme.surface-2;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-line : Theme.border;

    Rectangle {
        x: (root.width - 34px) / 2;
        y: 8px;
        width: 34px;
        height: Theme.control-height;
        border-radius: 17px;
        background: root.selected ? Theme.accent : Theme.surface;
        Rectangle {
            x: 12px;
            y: 7px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.selected ? Theme.bg : Theme.accent;
        }
        Rectangle {
            x: 8px;
            y: 20px;
            width: 18px;
            height: 9px;
            border-radius: 5px;
            background: root.selected ? Theme.bg : Theme.accent;
        }
    }
    Text {
        x: 4px;
        y: 48px;
        width: root.width - 8px;
        text: root.profile;
        color: root.selected ? Theme.text : Theme.muted-2;
        font-size: 10px;
        horizontal-alignment: center;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

