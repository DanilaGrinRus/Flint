// Shared visual tokens for the Slint shell.
export global Theme {
    in property <color> bg: #0e0e10;
    in property <color> surface: #18181c;
    in property <color> surface-2: #222228;
    in property <color> surface-hover: #2a2a33;
    in property <color> border-strong: #3a3a46;
    in property <color> border: #2a2a32;
    in property <color> text: #f0f0f2;
    in property <color> muted: #8b8b95;
    in property <color> muted-2: #9a9aa4;
    in property <color> disabled: #404048;
    in property <color> accent: #6ee7b7;
    in property <color> accent-dim: #3fbf98;
    in property <color> warning: #e0b052;
    in property <color> danger: #e05252;
    in property <color> ok: #52b069;
    in property <color> accent-soft: #173a32;
    in property <color> accent-line: #2f6b59;
    in property <color> testnet-bg: #12261f;
    in property <color> warning-bg: #2e2410;
    in property <color> scrim: #000000b0;

    in property <length> radius-card: 18px;
    in property <length> radius-control: 10px;
    in property <length> gap: 12px;
    in property <length> control-height: 36px;
}

