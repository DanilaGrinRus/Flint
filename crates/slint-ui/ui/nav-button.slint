// Sidebar navigation item with an icon and a visible active state.
import { Theme } from "theme.slint";

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    height: 46px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: 12px;
    background: root.active ? #173a32
        : touch.has-hover ? Theme.surface-2 : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? #2f6b59 : transparent;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    if root.active: Rectangle {
        x: 10px;
        y: (parent.height - 18px) / 2;
        width: 3px;
        height: 18px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        x: 22px;
        y: 0;
        width: parent.width - 34px;
        height: parent.height;
        spacing: 10px;

        Image {
            source: root.icon;
            colorize: root.active ? Theme.accent : Theme.muted;
            width: 20px;
            height: 20px;
            image-fit: contain;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.muted-2;
            font-size: 14px;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

