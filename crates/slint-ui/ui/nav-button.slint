// Sidebar navigation item with an icon and a visible active state.
import { Theme } from "theme.slint";

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    height: 46px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: 12px;
    background: root.active ? Theme.accent-soft
        : touch.has-hover ? Theme.surface-hover : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.accent-line : transparent;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    if root.active: Rectangle {
        x: 8px;
        y: (parent.height - 20px) / 2;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: Theme.accent;
    }

    HorizontalLayout {
        x: 20px;
        y: 0;
        width: parent.width - 32px;
        height: parent.height;
        spacing: 12px;

        Rectangle {
            width: 20px;
            Image {
                source: root.icon;
                colorize: root.active ? Theme.accent : Theme.muted;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.text : Theme.muted-2;
            font-size: 14px;
            font-weight: root.active ? 600 : 500;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
