+/// Creates and commits a new output for legacy recipient flows.
+pub fn build_recipient_output<C, K>(
+	wallet: &mut WalletBackend<C, K>,
+	keychain_mask: Option<&SecretKey>,
+	slate: &mut Slate,
+	current_height: u64,
+	parent_key_id: Identifier,
+	use_test_rng: bool,
+	is_initiator: bool,
+) -> Result<(Identifier, Context, TxLogEntry), Error>
+where
+	C: NodeClient,
+	K: Keychain,
+{
+	let prepared = prepare_recipient_output(
+		wallet,
+		keychain_mask,
+		slate,
+		current_height,
+		parent_key_id.clone(),
+		use_test_rng,
+		is_initiator,
+	)?;
+	let key_id = prepared.output.key_id.clone();
+	let mut batch = wallet.batch(keychain_mask)?;
+	if batch.next_tx_log_id(&parent_key_id)? != prepared.tx_log_entry.id {
+		return Err(Error::GenericError(
+			"Конфликт идентификатора транзакции".to_owned(),
+		));
+	}
+	batch.save(prepared.output)?;
+	batch.save_tx_log_entry(prepared.tx_log_entry.clone(), &parent_key_id)?;
+	batch.commit()?;
+	Ok((key_id, prepared.context, prepared.tx_log_entry))
 }
 
